(* Catalogue Template Language 1 (CTL1), normative EBNF. *)
template          = { text | escaped-open | escaped-close | interpolation | comment | block } ;
interpolation     = open, ws, reference, { ws, "|", ws, transform }, ws, close ;
comment           = comment-open, { comment-char }, close ;
block             = if-block | unless-block | each-block ;
if-block          = block-open, "if", ws1, condition, ws, close, template,
                    [ else-directive, template ], end-open, "if", ws, close ;
unless-block      = block-open, "unless", ws1, condition, ws, close, template,
                    [ else-directive, template ], end-open, "unless", ws, close ;
each-block        = block-open, "each", ws1, identifier, ws, close, template,
                    [ else-directive, template ], end-open, "each", ws, close ;
else-directive    = open, ws, "else", ws, close ;
open              = "{{", [ "~" ] ;
close             = [ "~" ], "}}" ;
comment-open      = "{{", [ "~" ], "!" ;
block-open        = "{{", [ "~" ], "#" ;
end-open          = "{{", [ "~" ], "/" ;
escaped-open      = "{{{{" ;
escaped-close     = "}}}}" ;
reference         = identifier | "this" | "@index" | "@first" | "@last" ;
transform         = "trim" | "lower" | "upper" | "snake_case" | "kebab_case"
                  | "pascal_case" | "camel_case" | "kebab_to_snake" ;
condition         = unary ;
unary             = [ "not", ws1 ], primary ;
primary           = boolean-reference
                  | reference, ws, comparison, ws, literal
                  | "contains", ws, "(", ws, identifier, ws, ",", ws, literal, ws, ")"
                  | "(", ws, condition, ws, ")" ;
boolean-reference = reference ;
comparison        = "==" | "!=" ;
literal           = json-string | json-number | "true" | "false" | "null" ;
identifier        = letter, { letter | digit | "_" } ;
letter            = "A"…"Z" | "a"…"z" ;
digit             = "0"…"9" ;
json-string       = quotation-mark, { json-char | escape }, quotation-mark ;
quotation-mark    = ? U+0022 QUOTATION MARK ? ;
reverse-solidus   = ? U+005C REVERSE SOLIDUS ? ;
json-char         = ? Unicode scalar except U+0022, U+005C, or U+0000..U+001F ? ;
escape            = reverse-solidus, ( quotation-mark | reverse-solidus | "/" | "b" | "f" | "n" | "r" | "t" | unicode-escape ) ;
unicode-escape    = "u", hex, hex, hex, hex ;
hex               = digit | "A"…"F" | "a"…"f" ;
json-number       = [ "-" ], ( "0" | nonzero-digit, { digit } ),
                    [ ".", digit, { digit } ], [ ( "e" | "E" ), [ "+" | "-" ], digit, { digit } ] ;
nonzero-digit     = "1"…"9" ;
ws                = { ws-char } ;
ws1               = ws-char, ws ;
ws-char           = " " | "\t" | "\r" | "\n" ;
text              = text-char, { text-char } ;
text-char         = ? any Unicode scalar that does not begin "{{", "}}}}", or a directive ? ;
comment-char      = ? any Unicode scalar not beginning a close delimiter "}}" or "~}}" ? ;

(* A left marker {{~ trims immediately preceding ASCII whitespace; a right
   marker ~}} trims immediately following ASCII whitespace. Marker placement is
   represented by open/close above and applies uniformly to all directives. *)
