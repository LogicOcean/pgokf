{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.codecatalogue.dev/bundle/v1/manifest.json",
  "title": "Manifest",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "code-catalogue-bundle"
    },
    "format_version": {
      "type": "integer",
      "const": 1
    },
    "bundle_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "hash_algorithm": {
      "type": "string",
      "const": "sha-256"
    },
    "bundle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "properties": {
        "instance_id": {
          "type": "string",
          "format": "uuid"
        },
        "base_url": {
          "type": "string",
          "format": "uri"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "instance_id",
        "base_url",
        "name"
      ],
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "properties": {
        "versions": {
          "type": "string",
          "enum": [
            "current",
            "all",
            "released"
          ]
        },
        "entry_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "required": [
        "versions"
      ],
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "snippet",
              "template",
              "scaffold",
              "example"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "private",
              "team",
              "public"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "draft",
              "published",
              "archived"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "slug": {
                  "type": "string"
                },
                "display_name": {
                  "type": "string"
                }
              },
              "required": [
                "slug",
                "display_name"
              ],
              "additionalProperties": false
            }
          },
          "category_path": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "primary_language": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "license_spdx": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "versions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "number": {
                  "type": "integer",
                  "minimum": 1
                },
                "message": {
                  "type": "string"
                },
                "description_md": {
                  "type": "string"
                },
                "content_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "template_schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": true
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "files": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      },
                      "mode": {
                        "type": "string",
                        "enum": [
                          "text",
                          "binary"
                        ]
                      },
                      "language": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "lexer": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "media_type": {
                        "type": "string",
                        "minLength": 1
                      },
                      "size_bytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 26214400
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "archive_path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "is_template": {
                        "type": "boolean"
                      },
                      "executable": {
                        "type": "boolean"
                      },
                      "content": {
                        "type": "object",
                        "properties": {
                          "encoding": {
                            "type": "string",
                            "enum": [
                              "utf-8",
                              "base64"
                            ]
                          },
                          "content": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "encoding",
                          "content"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "path",
                      "mode",
                      "language",
                      "lexer",
                      "media_type",
                      "size_bytes",
                      "sha256",
                      "archive_path",
                      "is_template",
                      "executable"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 1000
                }
              },
              "required": [
                "id",
                "number",
                "message",
                "description_md",
                "content_sha256",
                "template_schema",
                "created_at",
                "files"
              ],
              "additionalProperties": false
            }
          },
          "releases": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "semver": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "version_id": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "required": [
                "name",
                "semver",
                "version_id"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "slug",
          "kind",
          "title",
          "summary",
          "visibility",
          "state",
          "tags",
          "category_path",
          "primary_language",
          "license_spdx",
          "versions",
          "releases"
        ],
        "additionalProperties": false
      }
    },
    "signature": {
      "type": "object",
      "properties": {
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "algorithm": {
          "type": "string",
          "const": "Ed25519"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "required": [
        "key_id",
        "algorithm",
        "value"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "format_version",
    "bundle_id",
    "created_at",
    "hash_algorithm",
    "bundle_sha256",
    "source",
    "selection",
    "entries"
  ],
  "additionalProperties": false
}
