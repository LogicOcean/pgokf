{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.codecatalogue.dev/sync/v1/version-payload.json",
  "title": "Version Payload",
  "type": "object",
  "properties": {
    "version_id": {
      "type": "string",
      "format": "uuid"
    },
    "entry_id": {
      "type": "string",
      "format": "uuid"
    },
    "number": {
      "type": "integer",
      "minimum": 1
    },
    "message": {
      "type": "string"
    },
    "description_md": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "template_schema": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "text",
              "binary"
            ]
          },
          "media_type": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "is_template": {
            "type": "boolean"
          },
          "executable": {
            "type": "boolean"
          },
          "body": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "encoding": {
                    "type": "string",
                    "enum": [
                      "utf-8",
                      "base64"
                    ]
                  },
                  "content": {
                    "type": "string"
                  }
                },
                "required": [
                  "encoding",
                  "content"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "size_bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "media_type": {
                    "type": "string"
                  },
                  "expires_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "source_instance_id": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "required": [
                  "url",
                  "sha256",
                  "size_bytes",
                  "media_type",
                  "expires_at",
                  "source_instance_id"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "path",
          "mode",
          "media_type",
          "size_bytes",
          "sha256",
          "is_template",
          "executable",
          "body"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    }
  },
  "required": [
    "version_id",
    "entry_id",
    "number",
    "message",
    "description_md",
    "metadata",
    "template_schema",
    "content_sha256",
    "created_at",
    "files"
  ],
  "additionalProperties": false
}
