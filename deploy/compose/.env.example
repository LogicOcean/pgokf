# pgokf compose stack - copy to .env next to docker-compose.yml and fill in.
# Keep this file private (chmod 600): it holds every credential of the stack.
# Values with quotes or spaces must be quoted; the JSON policy below is quoted.

# ---- images -----------------------------------------------------------------
# Multi-architecture images are published on every version tag
# (ghcr.io/logicocean/pgokf:<version>-pg<major>, .../pgokf-companions:<version>).
# For a local build, use the tag you built (see packaging/docker/README.md).
PGOKF_IMAGE=ghcr.io/logicocean/pgokf:0.1.15-pg18
PGOKF_COMPANIONS_IMAGE=ghcr.io/logicocean/pgokf-companions:0.1.15

# ---- host paths ---------------------------------------------------------------
# Cluster data (fast local disk), the read-only bundle tree, and backups.
PGOKF_DATA_DIR=/srv/pgokf/data
PGOKF_BUNDLES_DIR=/srv/pgokf/bundles
PGOKF_BACKUP_DIR=/srv/pgokf/backups
# Container-side PGDATA; the default matches the postgres:18 image.
# PGOKF_PGDATA=/var/lib/postgresql/18/docker
# Libraries to preload. The default fits the PostgreSQL 17/18 images (which
# carry pg_textsearch); a 15/16/19 image needs "pgokf,pg_cron", an image built
# with ParadeDB needs "pgokf,pg_cron,pg_search".
# PGOKF_PRELOAD=pgokf,pg_cron,pg_textsearch

# ---- listener -----------------------------------------------------------------
# Interface to publish 5432 on. Loopback by default; a private/VPN address to
# reach it from other hosts. Never a public interface without TLS + firewall.
PGOKF_BIND_ADDR=127.0.0.1
PGOKF_PORT=5432
PGOKF_NETWORK=pgokf-net

# ---- credentials (generate each: openssl rand -hex 24) -----------------------
# Hex output is URL-safe, which matters because the companions embed these in
# connection URLs (an `@`, `/`, or `:` would need percent-encoding), and it
# contains no `$`, which compose would otherwise interpolate (a literal `$`
# must be written `$$`).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=okf
PGOKF_ADMIN_PASSWORD=
PGOKF_WRITER_PASSWORD=
PGOKF_READER_PASSWORD=
# Role names are configurable; the defaults are okf_admin / okf_writer / okf_reader.
# PGOKF_ADMIN_ROLE=okf_admin
# PGOKF_WRITER_ROLE=okf_writer
# PGOKF_READER_ROLE=okf_reader

# ---- catalog policy (applied once, on first init; later via pgokf.set_config) --
# embedding_dim MUST equal the dimension your embedding model returns (e.g.
# 1024 for Qwen3-Embedding-0.6B, 768 for nomic-embed-text, 1536 for
# text-embedding-3-small). store_source=true keeps the source bytes in the
# database so one pg_dump is a complete backup (docs/deployment-topologies.md).
# allowed_roots confines register_bundle to the /bundles mount.
# search_backend: "native" (default) or "bm25" (Tiger Data pg_textsearch,
# shipped in the PostgreSQL 17/18 images; run pgokf.rebuild_search_index()
# after loading data). bm25_provider defaults to "auto" (pg_textsearch when
# installed, else ParadeDB pg_search).
PGOKF_POLICY='{"embedding_dim": 1024, "store_source": true, "allowed_roots": ["/bundles"], "search_backend": "native"}'

# ---- embedder (pgokf-embed --watch) ---------------------------------------------
# Base URL of any OpenAI-compatible embeddings server (Ollama, vLLM,
# text-embeddings-inference, OpenAI); /v1/embeddings is appended automatically.
OKF_EMBED_ENDPOINT=http://ollama.internal:11434
OKF_EMBED_MODEL=hf.co/Qwen/Qwen3-Embedding-0.6B-GGUF:Q8_0
OKF_EMBED_API_KEY=
OKF_EMBED_INTERVAL=60
OKF_EMBED_BATCH=32
OKF_EMBED_MAX_CHARS=8000

# ---- server sizing (docs/operations.md) ---------------------------------------
PGOKF_SHM_SIZE=1g
PGOKF_SHARED_BUFFERS=1GB
PGOKF_EFFECTIVE_CACHE_SIZE=3GB
PGOKF_MAINTENANCE_WORK_MEM=512MB
PGOKF_WORK_MEM=32MB
PGOKF_LOG_MIN_DURATION_MS=1000
# GUC ceilings (hard limits; docs/configuration.md)
PGOKF_MAX_FILE_BYTES=8388608
PGOKF_MAX_BUNDLE_FILES=250000
PGOKF_MAX_FRONTMATTER_BYTES=262144
PGOKF_MAX_GRAPH_HOPS=8

# ---- backups (docker compose run --rm backup) -----------------------------------
PGOKF_BACKUP_RETENTION_DAYS=14

# ---- optional: mountless ingestion (docker compose --profile ingest up -d) --------
# OKF_S3_BUCKET=okf-bundles
# OKF_S3_PREFIX=handbook/
# OKF_S3_ENDPOINT=http://minio.internal:9000
# OKF_S3_ALLOW_HTTP=true
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# OKF_BUNDLE_NAME=handbook
# OKF_INGEST_INTERVAL=60

# ---- optional: MCP server (docker compose run --rm -T mcp) -------------------------
# OKF_MCP_TENANT=
