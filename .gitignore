/target/
# MkDocs build output - generated by `mkdocs build`, never versioned.
/site/
**/*.rs.bk
*.swp
*.swo
.DS_Store
.env
.env.*
!.env.example
.idea/
.vscode/
.cargo-pgrx/

# AI assistant settings - per-developer local state, never versioned.
.claude/

# Packaging build output - never commit built packages or images.
/packaging/**/build/
*.deb
*.rpm

# cargo-about scratch output; the committed notices file is THIRD-PARTY-NOTICES.txt
/notices-fresh.txt
